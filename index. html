<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F6F2EA; --surface:#FBF9F4; --ink:#22251F; --muted:#5A6058; --moss:#424F47; --copper:#A87548; --line:#DDD5C6; --on-moss:#F3EEE3;
  --head:"Poppins",system-ui,-apple-system,"Segoe UI",sans-serif;
  --body:"Lora",Georgia,"Times New Roman",serif;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#171C18;--surface:#1F2621;--ink:#EDE8DC;--muted:#A7AEA4;--moss:#2C3830;--copper:#C99566;--line:#33403A;--on-moss:#F3EEE3}
}
:root[data-theme="dark"]{--bg:#171C18;--surface:#1F2621;--ink:#EDE8DC;--muted:#A7AEA4;--moss:#2C3830;--copper:#C99566;--line:#33403A;--on-moss:#F3EEE3}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.125rem/1.75 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit}
:focus-visible{outline:3px solid var(--copper);outline-offset:3px;border-radius:4px}
.wrap{max-width:66rem;margin:0 auto;padding:0 1.25rem}
h1,h2,h3{font-family:var(--head);font-weight:600;line-height:1.15;margin:0;letter-spacing:-.015em}
h2{font-size:clamp(1.7rem,4vw,2.4rem)}
p{margin:0 0 1em}
.btn{display:inline-block;background:var(--moss);color:var(--on-moss);padding:.9rem 1.6rem;border-radius:999px;font:600 1rem var(--head);text-decoration:none;border:1.5px solid var(--moss);transition:background .2s,border-color .2s}
.btn:hover{background:var(--copper);border-color:var(--copper);color:#fff}
.btn.alt{background:transparent;color:var(--ink);border-color:var(--copper)}
.btn.alt:hover{background:var(--copper);color:#fff}
.rule{width:4.5rem;height:2px;background:var(--copper);border:0;margin:0 0 1.5rem}

header{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0;font-family:var(--head)}
.brand{font-weight:600;text-decoration:none}
nav a{margin-left:1.4rem;text-decoration:none;color:var(--muted);font-size:.92rem}
nav a:hover{color:var(--ink)}
@media(max-width:600px){nav a:not(.buy){display:none}}

.hero{display:grid;grid-template-columns:1.15fr .85fr;gap:3.5rem;align-items:center;padding:2.5rem 0 5.5rem}
.hero h1{font-size:clamp(2.4rem,6.4vw,4.4rem);line-height:1.05;font-weight:700}
.hero .sub{font-style:italic;font-size:1.3rem;color:var(--muted);max-width:32rem;margin:1.5rem 0 .5rem}
.hero .by{font:500 1rem var(--head);margin:0 0 2rem}
.hero .actions{display:flex;gap:.75rem;flex-wrap:wrap}
.cover{margin:0 auto;max-width:21rem;width:100%}
.cover img{display:block;width:100%;height:auto;border-radius:4px 10px 10px 4px;box-shadow:0 30px 55px -25px rgba(34,37,31,.55),0 0 0 1px rgba(0,0,0,.06)}
@media(max-width:820px){.hero{grid-template-columns:1fr;gap:2.5rem;padding-top:1rem}.cover{max-width:15rem;order:-1}}

.moments{background:var(--surface);border-block:1px solid var(--line);padding:4.5rem 0}
.moments .grid{display:grid;grid-template-columns:1fr 1.2fr;gap:3rem;align-items:start}
.moments ul{list-style:none;margin:0;padding:0}
.moments li{font-size:1.4rem;padding:.9rem 0;border-bottom:1px solid var(--line)}
.moments li:last-child{border:0;font-style:italic;color:var(--copper)}
@media(max-width:820px){.moments .grid{grid-template-columns:1fr;gap:1.5rem}}

.frameworks{padding:5rem 0}
.frameworks .intro{max-width:36rem;color:var(--muted);margin-top:1rem}
.tabs{display:flex;flex-wrap:wrap;gap:.5rem;margin:2.25rem 0 1.25rem}
.tabs button{font:500 .95rem var(--head);color:var(--ink);background:transparent;border:1.5px solid var(--line);padding:.65rem 1.1rem;border-radius:999px;cursor:pointer;transition:background .2s,border-color .2s}
.tabs button:hover{border-color:var(--copper)}
.tabs button[aria-selected="true"]{background:var(--moss);color:var(--on-moss);border-color:var(--moss)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:2rem}
.panel[hidden]{display:none}
.panel h3{font-size:1.5rem;margin-bottom:.5rem}
.panel > p{color:var(--muted);max-width:38rem}
.steps{list-style:none;margin:1.5rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:1rem}
.steps li{border-top:2px solid var(--copper);padding-top:.75rem}
.steps b{display:block;font:600 1rem var(--head);margin-bottom:.15rem}
.steps span{font-size:.98rem;color:var(--muted);line-height:1.5;display:block}
.audit{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.5rem 0 0;padding:0;list-style:none}
.audit li{border:1px solid var(--line);border-radius:999px;padding:.35rem .9rem;font:500 .92rem var(--head)}
.fine{margin:1.25rem 0 0;font-size:.98rem;font-style:italic;color:var(--muted)}

.inside{background:var(--moss);color:var(--on-moss);padding:5rem 0}
.inside h2{margin-bottom:.75rem}
.inside .lead{max-width:38rem;opacity:.88}
.chapters{list-style:none;margin:2.5rem 0 0;padding:0;counter-reset:c;border-top:1px solid rgba(243,238,227,.25)}
.chapters li{counter-increment:c;display:grid;grid-template-columns:3.5rem 1fr;gap:.25rem 1rem;padding:1.15rem 0;border-bottom:1px solid rgba(243,238,227,.25)}
.chapters li::before{content:counter(c);font:600 1.6rem/1.2 var(--head);color:var(--copper);filter:brightness(1.25)}
.chapters h3{font-size:1.15rem;font-weight:600}
.chapters p{margin:.2rem 0 0;opacity:.8;font-size:1rem;line-height:1.6;grid-column:2}
@media(max-width:600px){.chapters li{grid-template-columns:2.4rem 1fr}}

.quote{padding:5rem 0 1rem;text-align:center}
.quote blockquote{margin:0 auto;max-width:40rem;font-style:italic;font-size:clamp(1.4rem,3.2vw,1.9rem);line-height:1.5}
.quote hr{margin:0 auto 1.75rem}

.cta{padding:4rem 0 5.5rem;text-align:center}
.cta p{max-width:32rem;margin:1.25rem auto 2rem;color:var(--muted)}
footer{border-top:1px solid var(--line);padding:1.5rem 0 2rem;color:var(--muted);font:400 .85rem/1.6 var(--head)}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem 2rem}
footer p{margin:0;max-width:34rem}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <a class="brand" href="#top">The Quiet Strength</a>
    <nav>
      <a href="#frameworks">Frameworks</a>
